# CausalOps Backend Environment Configuration Example
# Copy this file to .env and supply your credentials. Never commit real keys.

# Google Gemma API Key for context-aware remediation & competing hypotheses
GEMMA_API_KEY=""

# Gemma Model Identifier
GEMMA_MODEL_NAME="gemma-4-26b-a4b-it"

# Request timeout in milliseconds (Google GenAI requires minimum 10000ms; recommended 45000ms)
GEMMA_TIMEOUT_MS=45000

# Base URL for Google GenAI / Vertex AI endpoints (optional)
GEMMA_API_BASE="https://generativelanguage.googleapis.com/v1beta"

# Fernet Secret Key for Encrypting GitHub PAT Tokens at Rest (32 url-safe base64-encoded bytes)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=""
